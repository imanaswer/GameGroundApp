{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://www.gameground.net",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "rzp_test_replace_me",
        "EXPO_PUBLIC_POSTHOG_KEY": ""
      },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://www.gameground.net",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "rzp_test_replace_me",
        "EXPO_PUBLIC_POSTHOG_KEY": ""
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://www.gameground.net",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "rzp_live_replace_me",
        "EXPO_PUBLIC_POSTHOG_KEY": ""
      }
    }
  },
  "submit": { "production": {} }
}
