{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://www.gameground.net",
        "EXPO_PUBLIC_APPLE_AUTH_ENABLED": "true"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://www.gameground.net",
        "EXPO_PUBLIC_APPLE_AUTH_ENABLED": "true",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_BixwEjS5F5VUpneQ5DWgqiatiNWDxFXg2NtYw8Cbcozr"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://www.gameground.net",
        "EXPO_PUBLIC_APPLE_AUTH_ENABLED": "true",
        "EXPO_PUBLIC_POSTHOG_KEY": "phc_BixwEjS5F5VUpneQ5DWgqiatiNWDxFXg2NtYw8Cbcozr"
      }
    },
    "production-apk": {
      "extends": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
